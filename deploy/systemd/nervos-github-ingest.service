[Unit]
Description=Nervos Brain GitHub docs/code incremental ingest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PROJECT_ROOT=%h/path/to/Nervos-Brain
Environment=ENV_RUNNER_BIN=%h/miniconda3/bin/conda
Environment=ENV_NAME=nervos-brain
EnvironmentFile=-%h/.config/nervos-brain/github-ingest.env
ExecStart=/bin/bash -lc 'cd "$PROJECT_ROOT" && "$ENV_RUNNER_BIN" run -n "$ENV_NAME" python scripts/run_github_docs_ingest.py --incremental && "$ENV_RUNNER_BIN" run -n "$ENV_NAME" python scripts/run_github_code_ingest.py --incremental'
