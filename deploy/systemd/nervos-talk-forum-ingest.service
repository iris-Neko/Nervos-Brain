[Unit]
Description=Nervos Brain Talk forum incremental ingest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PROJECT_ROOT=%h/path/to/Nervos-Brain
Environment=ENV_RUNNER_BIN=%h/miniconda3/bin/conda
Environment=ENV_NAME=nervos-brain
Environment=TALK_LATEST_PAGES=3
ExecStart=/bin/bash -lc 'cd "$PROJECT_ROOT" && "$ENV_RUNNER_BIN" run -n "$ENV_NAME" python scripts/run_talk_forum_ingest.py --latest-pages "$TALK_LATEST_PAGES" --incremental'
